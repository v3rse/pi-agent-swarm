{
  "name": "pi-agent-swarm",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions across herdr/tmux/zellij/wezterm terminals. A herdr-first port of HazAT/pi-interactive-subagents. Model-agnostic: subagents inherit the dispatching session's model unless you set one.",
  "keywords": [
    "pi-package",
    "subagents",
    "multiplexer",
    "herdr"
  ],
  "license": "MIT",
  "author": "HazAT (original) - v3rse (herdr port + maintenance)",
  "repository": {
    "type": "git",
    "url": "https://github.com/v3rse/pi-agent-swarm"
  },
  "homepage": "https://github.com/v3rse/pi-agent-swarm#readme",
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "skills:install": "bash scripts/install-skills.sh"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@mariozechner/pi-tui": "^0.65.0",
    "@sinclair/typebox": "^0.34.49"
  }
}
